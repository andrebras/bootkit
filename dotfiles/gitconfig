[user]
  name = André Brás
  email = andrebras@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKG5JeHPf5DVaL09SSsa5mMWhSbBSop4GHaLufzyNko4

[core]
  excludesfile = /Users/andrebras/.gitignore_global
  autocrlf = input
  safecrlf = true
  editor = vim
  quotepath = false
  pager = diff-so-fancy | less --tabs=4 -RF
  ; commentchar = !
  ; editor = code --new-window --disable-extensions --wait

[init]
  defaultBranch = main
[commit]
	gpgsign = true

[pull]
  rebase = merges

[fetch]
  prune = true

[merge]
  tool = opendiff

[diff]
  tool = opendiff

[mergetool]
  prompt     = false
  keepBackup = false
  ; trustExitCode = true

[mergetool "opendiff"]
  cmd = opendiff $LOCAL $REMOTE -merge $MERGED

[mergetool "vscode"]
  cmd = code --wait $MERGED

[difftool]
  prompt = false

[difftool "opendiff"]
  cmd = opendiff "$LOCAL" "$REMOTE"

[filter "media"]
  required = true
  clean    = git media clean %f
  smudge   = git media smudge %f

[filter "lfs"]
  process  = git-lfs filter-process
  required = true
  clean    = git-lfs clean -- %f
  mudge    = git-lfs smudge -- %f
  smudge   = git-lfs smudge -- %f

[color]
  diff   = auto
  status = auto
  branch = auto
  ui     = auto

[rerere]
  enabled = true

[column]
  ui = auto

[branch]
  sort = -committerdate

[interactive]
  diffFilter = diff-so-fancy --patch

[alias]
  switchback = switch -
  sb = switchback
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.ssh/allowed_signers

# Machine-specific settings live in ~/.gitconfig.local (not tracked by BootKit).
# Create it by hand on a new machine, e.g. for background maintenance:
#   git maintenance register --config-file ~/.gitconfig.local
[include]
	path = ~/.gitconfig.local
