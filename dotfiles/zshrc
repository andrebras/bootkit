# set gpg tty to the current terminal
export GPG_TTY=$(tty)

#
# Paths
#

# Ensure path arrays do not contain duplicates.
typeset -gU cdpath path

# Set the the list of directories that cd searches.
cdpath=(
  /Users/andrebras/Lab
  /Users/andrebras
  /Volumes
  $cdpath
)

# fpath additions must come before compinit (called by prezto completion below)
fpath=(/Users/andrebras/.docker/completions ~/.grok/completions/zsh $fpath)

#
# zgenom
#

# Load zgenom
source "${HOME}/.zgenom/zgenom.zsh"

# Check for plugin and zgenom updates every 7 days
zgenom autoupdate

# Create zgenom init script
if ! zgenom saved; then
  echo "Creating a zgenom save"

  # prezto options
  zgenom prezto '*' color 'yes'
  zgenom prezto 'terminal:window-title' 'yes'
  zgenom prezto prompt theme 'cloud'

  zgenom prezto 'git:log:oneline' format '_git_log_oneline_format'
  zgenom prezto 'git:log:brief'   format '_git_log_brief_format'

  # prezto and modules
  zgenom prezto
  zgenom prezto autosuggestions
  zgenom prezto command-not-found
  zgenom prezto completion
  zgenom prezto git
  zgenom prezto history-substring-search
  zgenom prezto osx
  zgenom prezto ruby
  zgenom prezto syntax-highlighting
  zgenom prezto terminal
  zgenom prezto utility

  # create init script
  zgenom save
fi

# Incremental search with ctr + r
# bindkey '^R' history-incremental-search-backward

# Source all files inside the alias folder
alias_dir="$HOME/.config/alias"

if [[ -d "${alias_dir}" ]]; then
  for file in ${alias_dir}/**/*(.N); do
    source "$file"
  done
fi

# fzf
source <(fzf --zsh)

# Zoxide
eval "$(zoxide init zsh)"

# Hook direnv into zsh
eval "$(direnv hook zsh)"
